---
// ContactSection.astro — Seção de contato com canais diretos e formulário minimalista
---

<!-- ==========================================================================
     SEÇÃO 07 — CONTATO (CHAMADA ELEGANTE, DIRETA E CONVIDATIVA)
     ========================================================================== -->
<section class="contact-section" id="contato">
  <div class="contact-card-hero">
    <div class="contact-intro">
      <div class="section-tag reveal-fade" data-reveal-delay="0.1">Iniciar um Projeto</div>
      <h2 class="contact-title reveal-trigger" data-reveal-delay="0.2">
        Antes de qualquer traço, uma conversa. Vamos dar início ao seu projeto?
      </h2>
      <p class="contact-lead reveal-para" data-reveal-delay="0.3">
        Queremos conhecer suas ideias, entender suas necessidades e descobrir o que você imagina para o seu espaço. Entre em contato e dê o primeiro passo para desenvolver seu projeto com a gente.
      </p>
    </div>

    <div class="contact-direct-channels reveal-fade" data-reveal-delay="0.4">
      <a href="https://wa.me/5583986126156?text=Ol%C3%A1%2C%20Ribeiro%20e%20S%C3%A1%21%20Conheci%20o%20trabalho%20de%20voc%C3%AAs%20pelo%20site%20e%20gostaria%20de%20conversar%20sobre%20um%20projeto%20de%20arquitetura.%20Podemos%20conversar%3F" target="_blank" rel="noopener noreferrer" class="direct-channel-link">
        <span>Conversar via WhatsApp</span> 
        <iconify-icon icon="solar:chat-round-line-bold"></iconify-icon>
      </a>

      <a href="mailto:contato.ribeiroesa@gmail.com" class="direct-channel-link">
        <span>contato.ribeiroesa@gmail.com</span>
        <iconify-icon icon="solar:letter-linear"></iconify-icon>
      </a>

      <!-- Instagram de Beatriz -->
      <a
        href="https://www.instagram.com/beatrizribeiro.arq/"
        target="_blank"
        rel="noopener noreferrer"
        class="direct-channel-link"
      >
        <span>Beatriz Ribeiro · @beatrizribeiro.arq</span>
        <iconify-icon icon="ri:instagram-line"></iconify-icon>
      </a>

      <!-- Instagram de Vandemberg -->
      <a
        href="https://www.instagram.com/arq.vandembergsa/"
        target="_blank"
        rel="noopener noreferrer"
        class="direct-channel-link"
      >
        <span>Vandemberg · @arq.vandembergsa</span>
        <iconify-icon icon="ri:instagram-line"></iconify-icon>
      </a>
    </div>

    <div class="contact-form-col">
      <form class="contact-form reveal-fade" id="contact-form" data-reveal-delay="0.35" aria-label="Formulário de contato" novalidate>
        <div class="form-group">
          <label for="form-name" class="form-label">Nome Completo</label>
          <input 
            type="text" 
            id="form-name" 
            name="nome"
            class="form-input" 
            placeholder="Seu nome completo" 
            required 
            autocomplete="name"
          />
        </div>

        <div class="form-group">
          <label for="form-phone" class="form-label">Telefone / WhatsApp</label>
          <input 
            type="tel" 
            id="form-phone" 
            name="telefone"
            class="form-input" 
            placeholder="DDD + Número (somente dígitos)" 
            inputmode="numeric" 
            maxlength="11" 
            required 
            autocomplete="tel"
          />
        </div>

        <div class="form-group">
          <label for="form-location" class="form-label">Cidade / Local do Terreno</label>
          <input 
            type="text" 
            id="form-location" 
            name="local"
            class="form-input" 
            placeholder="Ex: Campina Grande, PB" 
            required 
          />
        </div>

        <div class="form-group">
          <label for="form-type" class="form-label">Tipo de Projeto</label>
          <select id="form-type" name="tipo" class="form-input form-select" required>
            <option value="" disabled selected>Selecione uma opção...</option>
            <option value="residencial-construcao">Residencial — Nova Construção</option>
            <option value="residencial-reforma">Residencial — Reforma Geral</option>
            <option value="interiores">Arquitetura de Interiores</option>
            <option value="comercial">Comercial / Espaço Criativo</option>
            <option value="outro">Consultoria de Terreno / Outro</option>
          </select>
        </div>

        <div class="form-group">
          <label for="form-message" class="form-label">Breve Descrição do Projeto</label>
          <textarea 
            id="form-message" 
            name="mensagem"
            class="form-textarea" 
            placeholder="Conte-nos um pouco sobre a área aproximada, fase em que está e prazos desejados."
            required
          ></textarea>
        </div>

        <button type="submit" class="form-submit-btn">
          <span>Enviar Mensagem</span>
          <iconify-icon icon="solar:arrow-right-up-linear"></iconify-icon>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 120px 32px 80px;
    max-width: var(--site-max-width);
    margin: 0 auto;
  }

  .contact-card-hero {
    background: linear-gradient(180deg, var(--surface-dark-2), var(--surface-dark));
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-xl);
    padding: 72px 64px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    grid-template-areas:
      "intro form"
      "channels form";
    column-gap: 64px;
    row-gap: 0;
    align-items: start;
    box-shadow: 0 30px 100px rgba(0, 0, 0, 0.5);
    margin-bottom: 0;
  }

  .contact-intro {
    grid-area: intro;
  }

  .contact-direct-channels {
    grid-area: channels;
  }

  .contact-form-col {
    grid-area: form;
  }

  .contact-title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--text-primary-dark);
    line-height: 1.1;
    margin-bottom: 20px;
  }

  .contact-lead {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted-dark);
    margin-bottom: 40px;
    max-width: 520px;
  }

  .contact-direct-channels {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .direct-channel-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    background: var(--surface-dark-elevated);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-pill);
    padding: 14px 24px;
    color: var(--text-primary-dark);
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: all var(--transition-fast);
  }

  .direct-channel-link:hover {
    border-color: var(--accent-bronze);
    background: rgba(196, 159, 115, 0.1);
    transform: translateX(4px);
  }

  .direct-channel-link iconify-icon {
    font-size: 1.125rem;
    color: var(--accent-bronze);
  }

  /* Formulário Minimalista de Contato */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-subtle-dark);
  }

  .form-input, .form-textarea {
    background: rgba(18, 16, 14, 0.6);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    color: var(--text-primary-dark);
    font-size: 0.875rem;
    transition: border-color var(--transition-fast);
  }

  .form-select {
    background-color: #1A1714;
  }

  .form-input:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--accent-bronze);
  }

  .form-input.is-invalid,
  .form-textarea.is-invalid,
  .form-select.is-invalid {
    border-color: #E06A55 !important;
    background: rgba(224, 106, 85, 0.05);
  }

  .form-input.is-invalid:focus,
  .form-textarea.is-invalid:focus,
  .form-select.is-invalid:focus {
    border-color: #E06A55 !important;
    box-shadow: 0 0 0 1px rgba(224, 106, 85, 0.3);
  }

  :global(.form-error-msg) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: #E06A55;
    margin-top: 4px;
    display: block;
    animation: fadeInError 0.2s ease;
  }

  @keyframes fadeInError {
    from {
      opacity: 0;
      transform: translateY(-2px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .form-textarea {
    resize: vertical;
    min-height: 100px;
  }

  .form-submit-btn {
    background: var(--accent-bronze);
    color: #12100E;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all var(--transition-fast);
    margin-top: 8px;
  }

  .form-submit-btn:hover {
    background: #D4B088;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(196, 159, 115, 0.25);
  }

  /* Feedback do Formulário */
  :global(.form-feedback-card) {
    background: rgba(196, 159, 115, 0.12);
    border: 1px solid var(--accent-bronze);
    border-radius: var(--radius-md);
    padding: 32px 24px;
    text-align: center;
  }

  :global(.form-feedback-title) {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--text-primary-dark);
    font-weight: 500;
    margin-bottom: 8px;
  }

  :global(.form-feedback-desc) {
    font-size: 0.875rem;
    color: var(--text-muted-dark);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .contact-card-hero {
      grid-template-columns: 1fr;
      grid-template-areas:
        "intro"
        "form"
        "channels";
      gap: 36px;
    }

    .contact-lead {
      margin-bottom: 0;
    }

    .contact-direct-channels {
      border-top: 1px solid var(--border-dark);
      padding-top: 28px;
    }
  }

  @media (max-width: 768px) {
    .contact-section {
      padding: 80px 16px 64px;
    }

    .contact-card-hero {
      padding: 36px 20px;
      gap: 32px;
    }
  }
</style>
