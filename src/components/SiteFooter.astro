---
// SiteFooter.astro — Rodapé arquitetônico autoral e créditos institucionais
---

<!-- Rodapé Arquitetônico Discreto -->
<footer class="site-footer" role="contentinfo">
  <div class="footer-top-grid">
    <div class="footer-brand-col">
      <a href="#hero" class="footer-logo-link" aria-label="Ribeiro & Sá Arquitetura - Voltar ao início">
        <img 
          src="/assets/logotipo-completo.png" 
          alt="Ribeiro & Sá Arquitetura" 
          class="footer-brand-logo" 
          width="190" 
          height="113"
          loading="lazy"
        />
      </a>
      <p class="footer-brand-desc">
        Arquitetura que parte das pessoas e transforma suas formas de viver em espaços com identidade e propósito.
      </p>
    </div>

    <div>
      <p class="footer-col-title">Navegação</p>
      <div class="footer-links-list">
        <a href="#hero" class="footer-link">Início</a>
        <a href="#projetos" class="footer-link">Projetos</a>
        <a href="#sobre" class="footer-link">Quem Somos</a>
        <a href="#abordagem" class="footer-link">Abordagem</a>
        <a href="#processo" class="footer-link">Processo</a>
        <a href="#casos" class="footer-link">Estudos de Caso</a>
      </div>
    </div>

    <div>
      <p class="footer-col-title">Ateliê & Contato</p>
      <div class="footer-links-list">
        <span class="footer-link-text">Campina Grande, Brasil</span>
        <span class="footer-link-text">Atendimento com hora marcada</span>
        <a href="mailto:contato.ribeiroesa@gmail.com" target="_blank" rel="noopener noreferrer" class="footer-link">contato.ribeiroesa@gmail.com</a>
        <a href="https://wa.me/55839986126156" target="_blank" rel="noopener noreferrer" class="footer-link">WhatsApp Direto</a>
      </div>
    </div>

    <div>
      <p class="footer-col-title">Redes & Publicações</p>

      <div class="footer-links-list">
        <a
          href="https://www.instagram.com/beatrizribeiro.arq/"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          Beatriz Ribeiro · Instagram
        </a>

        <a
          href="https://www.instagram.com/arq.vandembergsa/"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          Vandemberg · Instagram
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom-bar">
    <div>
      © 2026 Ribeiro & Sá Arquitetura. Todos os direitos reservados.
    </div>
    <div>
      Campina Grande · Paraíba · Brasil
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-dark);
    padding-top: 48px;
    max-width: var(--site-max-width);
    margin: 80px auto 0;
    padding-left: 32px;
    padding-right: 32px;
  }

  .footer-top-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 48px;
    margin-bottom: 56px;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo-link {
    display: inline-block;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .footer-logo-link:hover {
    opacity: 0.92;
    transform: translateY(-2px);
  }

  .footer-brand-logo {
    width: 200px;
    height: auto;
    object-fit: contain;
    display: block;
    margin-bottom: 8px;
  }

  .footer-brand-desc {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-subtle-dark);
    max-width: 320px;
  }

  .footer-col-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-bronze);
    margin-bottom: 18px;
  }

  .footer-links-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 0.875rem;
  }

  .footer-link {
    color: var(--text-muted-dark);
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--text-primary-dark);
  }

  .footer-link-text {
    color: var(--text-subtle-dark);
  }

  .footer-bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-dark);
    padding-top: 28px;
    padding-bottom: 40px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-subtle-dark);
    letter-spacing: 0.05em;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media (max-width: 768px) {
    .site-footer {
      padding-left: 16px;
      padding-right: 16px;
    }

    .footer-top-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .footer-brand-col {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 8px;
    }

    .footer-logo-link {
      display: flex;
      justify-content: center;
      margin: 0 auto;
    }

    .footer-brand-logo {
      margin-left: auto;
      margin-right: auto;
    }

    .footer-brand-desc {
      text-align: center;
      margin: 0 auto;
      max-width: 320px;
    }

    .footer-bottom-bar {
      flex-direction: column;
      text-align: center;
      gap: 12px;
    }
  }
</style>
