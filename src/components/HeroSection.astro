---
// HeroSection.astro — Seção de abertura com impacto arquitetônico e painel warm paper
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- ==========================================================================
     SEÇÃO 01 — HERO / APRESENTAÇÃO
     ========================================================================== -->
<section class="hero-shell" id="hero">
  <div class="hero-card">
    <div class="hero-visual-zone">
      <picture style="display: contents;">
        <source
          media="(max-width: 768px)"
          srcset={`${base}/assets/home-mobile.png`}
        />
        <img
          src={`${base}/assets/fachada-noturna-cobogo.webp`}
          alt="Arquitetura autoral contemporânea em concreto aparente e vidro por Ribeiro & Sá Arquitetura"
          class="hero-bg-img"
          loading="eager"
          fetchpriority="high"
        />
      </picture>

      <div class="hero-copy">
        <div class="eyebrow-pill reveal-fade" data-reveal-delay="0.1">
          <img
            src={`${base}/assets/monograma-cobre.png`}
            alt=""
            class="eyebrow-monogram"
            width="9"
            height="16"
          />
          Ribeiro & Sá · Arquitetura
        </div>

        <h1 class="hero-title reveal-trigger" data-reveal-delay="0.2">
          Cada história merece sua própria <span class="emphasis"
            >arquitetura</span
          >.
        </h1>

        <p class="hero-subtitle reveal-para" data-reveal-delay="0.35">
          Uma arquitetura que respeita o lugar e revela a identidade de quem a habita.
        </p>
      </div>
    </div>

    <!-- Painel Inferior de Transição (Warm Paper) -->
    <div class="hero-bottom-panel">
      <div class="hero-panel-grid">
        <div class="panel-left">
          <p class="panel-kicker reveal-fade" data-reveal-delay="0.1">
            A Prática do Escritório
          </p>
          <h2 class="panel-headline reveal-trigger" data-reveal-delay="0.2">
            Uma arquitetura que entende o lugar antes de ocupar o espaço.
          </h2>
          <p class="panel-desc reveal-para" data-reveal-delay="0.3">
            A arquitetura se constrói a partir de escolhas. Algumas definem a
            forma, outras transformam a maneira de sentir e utilizar um espaço.
            Nosso olhar está em compreender essas relações e conduzir cada
            decisão com cuidado, coerência e intenção.
          </p>

          <div class="hero-actions-row reveal-fade" data-reveal-delay="0.4">
            <a href="#projetos" class="btn-primary">
              Explorar Projetos
              <iconify-icon icon="solar:arrow-right-up-linear"></iconify-icon>
            </a>
            <a href="#sobre" class="btn-secondary"> Conhecer os Arquitetos </a>
          </div>
        </div>

        <div class="panel-mini-cards" data-reveal-stagger="0.15">
          <div class="mini-card" data-spotlight>
            <div class="mini-card-tag">Foco 01</div>
            <h3 class="mini-card-title">Olhar Individual</h3>
            <p class="mini-card-sub">
              Cada projeto é desenvolvido a partir de uma escuta atenta,
              considerando as necessidades, preferências e particularidades de
              cada cliente.
            </p>
          </div>

          <div class="mini-card" data-spotlight>
            <div class="mini-card-tag">Foco 02</div>
            <h3 class="mini-card-title">Atenção aos Detalhes</h3>
            <p class="mini-card-sub">
              Cada elemento é pensado em conjunto, das proporções e materiais às
              soluções que garantem harmonia e funcionalidade aos espaços.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-shell {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: 96px 20px 24px;
  }

  .hero-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-xl);
    background: linear-gradient(
      180deg,
      rgba(26, 23, 20, 0.95),
      rgba(18, 16, 14, 0.98)
    );
    box-shadow:
      0 30px 100px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .hero-visual-zone {
    position: relative;
    min-height: 80vh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 48px;
    background: #171411;
  }

  .hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    filter: brightness(0.72) contrast(1.05);
    transform: scale(1.03);
    transition: transform 12s ease-out;
  }

  .hero-card:hover .hero-bg-img {
    transform: scale(1.06);
  }

  .hero-visual-zone::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(18, 16, 14, 0.25) 0%,
      rgba(18, 16, 14, 0.4) 40%,
      rgba(18, 16, 14, 0.92) 100%
    );
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    max-width: 980px;
  }

  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-bronze);
    background: rgba(18, 16, 14, 0.65);
    border: 1px solid rgba(196, 159, 115, 0.25);
    border-radius: var(--radius-pill);
    padding: 5px 14px;
    margin-bottom: 24px;
    backdrop-filter: blur(8px);
  }

  .eyebrow-monogram {
    height: 14px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 6px rgba(196, 159, 115, 0.4));
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-bronze);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-bronze);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5.5vw, 5.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-primary-dark);
    margin-bottom: 24px;
  }

  .hero-title .emphasis {
    font-weight: 300;
    font-style: italic;
    color: #ede8df;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    color: rgba(245, 242, 235, 0.85);
    font-weight: 300;
    line-height: 1.65;
    max-width: 680px;
  }

  .hero-bottom-panel {
    background: var(--paper-bg);
    color: var(--text-primary-light);
    padding: 56px 48px;
    position: relative;
  }

  .hero-panel-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: center;
  }

  .panel-kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent-terracotta);
    margin-bottom: 12px;
  }

  .panel-headline {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 2.5vw, 2.5rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary-light);
    margin-bottom: 20px;
  }

  .panel-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-muted-light);
    max-width: 600px;
    margin-bottom: 32px;
  }

  .hero-actions-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .panel-mini-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .mini-card {
    position: relative;
    background: var(--paper-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 20px;
    overflow: hidden;
    transition: all var(--transition-fast);
  }

  .mini-card:hover {
    border-color: rgba(22, 21, 19, 0.3);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
  }

  .mini-card-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-terracotta);
    margin-bottom: 8px;
  }

  .mini-card-title {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary-light);
    line-height: 1.3;
    margin-bottom: 6px;
  }

  .mini-card-sub {
    font-size: 0.8125rem;
    color: var(--text-muted-light);
  }

  @media (max-width: 1024px) {
    .hero-panel-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 768px) {
    .hero-shell {
      padding: 80px 12px 16px;
    }

    .hero-visual-zone {
      min-height: 58vh;
      padding: 110px 20px 24px;
    }

    .hero-bg-img {
      object-position: 56% 40%;
    }

    .eyebrow-pill {
      font-size: 0.625rem;
      letter-spacing: 0.14em;
      padding: 4px 11px;
      margin-bottom: 14px;
    }

    .eyebrow-monogram {
      height: 12px;
    }

    .hero-title {
      font-size: clamp(1.75rem, 6.2vw, 2.25rem);
      line-height: 1.08;
      margin-bottom: 12px;
    }

    .hero-subtitle {
      font-size: 0.875rem;
      line-height: 1.55;
    }

    .hero-bottom-panel {
      padding: 28px 20px;
    }

    .panel-headline {
      font-size: clamp(1.375rem, 5.2vw, 1.75rem);
      margin-bottom: 14px;
    }

    .panel-desc {
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 24px;
    }

    .panel-mini-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
