---
// ProjectsSection.astro — Galeria editorial assimétrica de Arquitetura de Interiores
interface ProjectImage {
  src: string;
  alt: string;
  badge: string;
}

interface InteriorProject {
  id: string;
  category: 'convivio' | 'integrados' | 'intimos';
  title: string;
  meta: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
  images: [ProjectImage, ProjectImage];
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const interiorProjects: InteriorProject[] = [
  {
    id: '01',
    category: 'integrados',
    title: 'Interiores Casa Pátio',
    meta: 'Interiores · Estar, Jantar & Jardim Interno',
    description:
      'A transição fluida entre o jardim interno e a área social define este projeto de interiores, onde esquadrias pivotantes diluem o limite entre dentro e fora. Sob a laje de concreto aparente, o painel ripado em madeira e a parede de cobogós filtram a luz natural, compondo uma atmosfera acolhedora ao redor do mobiliário de linhas orgânicas e tons botânicos.',
    ctaLabel: 'Consultar Projeto de Interiores',
    ctaHref: '#contato',
    images: [
      {
        src: `${base}/assets/interiores-casa-patio-jardim.webp`,
        alt: 'Interiores Casa Pátio — Integração noturna entre o jardim interno e a sala de estar através de esquadrias pivotantes',
        badge: '01 · Transição & Jardim',
      },
      {
        src: `${base}/assets/interiores-casa-patio-estar.webp`,
        alt: 'Interiores Casa Pátio — Sala de jantar e estar com concreto aparente, painel ripado em madeira, cobogós e sofá curvo verde',
        badge: '01 · Estar & Jantar',
      },
    ],
  },
  {
    id: '02',
    category: 'convivio',
    title: 'Living & Jantar Sálvia',
    meta: 'Interiores · Estar, Circulação & Sala de Jantar',
    description:
      'Articulado por um pórtico em arco e uma paleta suave em verde-sálvia, o projeto integra estar e sala de jantar com serenidade visual. O aquecimento do painel em madeira nogueira dialoga com a textura mineral da parede em pedra natural, o estofado em bouclé off-white e os detalhes em mármore verde, criando uma sequência espacial contínua e silenciosa.',
    ctaLabel: 'Consultar Projeto de Interiores',
    ctaHref: '#contato',
    images: [
      {
        src: `${base}/assets/interiores-salvia-estar.webp`,
        alt: 'Living & Jantar Sálvia — Estar com painel em madeira nogueira, sofá em bouclé off-white, mesa em mármore verde e arco de transição',
        badge: '02 · Living & Marcenaria',
      },
      {
        src: `${base}/assets/interiores-salvia-jantar.webp`,
        alt: 'Living & Jantar Sálvia — Vista através do pórtico em arco para a sala de jantar com mesa circular em madeira e parede em pedra natural',
        badge: '02 · Pórtico & Jantar',
      },
    ],
  },
  {
    id: '03',
    category: 'integrados',
    title: 'Living & Cozinha Terracota',
    meta: 'Interiores · Cozinha Gourmet, Jantar & Estar',
    description:
      'Concebido para o convívio integrado, este projeto articula cozinha gourmet, jantar e estar em um único eixo fluido. As paredes em tom terracota envolvem o espaço com calor tátil, equilibradas pela bancada em mármore claro, pela marcenaria em madeira natural e pelo desenho orgânico do sofá curvo e da mesa de centro em pedra.',
    ctaLabel: 'Consultar Projeto de Interiores',
    ctaHref: '#contato',
    images: [
      {
        src: `${base}/assets/interiores-terracota-cozinha-jantar.webp`,
        alt: 'Living & Cozinha Terracota — Perspectiva a partir da bancada em mármore integrando mesa de jantar sob pendente linear e sala de estar',
        badge: '03 · Cozinha & Jantar',
      },
      {
        src: `${base}/assets/interiores-terracota-estar.webp`,
        alt: 'Living & Cozinha Terracota — Sala de estar com sofá curvo orgânico, paredes em terracota e integração com a marcenaria da cozinha',
        badge: '03 · Estar Integrado',
      },
    ],
  },
  {
    id: '04',
    category: 'intimos',
    title: 'Suíte Infantil Palhinha',
    meta: 'Interiores · Quarto Infantil & Amamentação',
    description:
      'Desenhado para acolher os primeiros anos com serenidade tátil, este quarto infantil combina painéis arqueados em madeira e palhinha natural em ritmo escalonado com o berço oval em laca clara e nogueira. A composição em tecidos bouclé, couro caramelo, fibras naturais e cortinas translúcidas valoriza a luz suave, criando um refúgio delicado e atemporal.',
    ctaLabel: 'Consultar Projeto de Interiores',
    ctaHref: '#contato',
    images: [
      {
        src: `${base}/assets/interiores-quarto-bebe-berco.webp`,
        alt: 'Suíte Infantil Palhinha — Berço oval em laca clara e nogueira junto aos painéis arqueados em palhinha natural e pendentes esculturais',
        badge: '04 · Berço & Iluminação',
      },
      {
        src: `${base}/assets/interiores-quarto-bebe-conjunto.webp`,
        alt: 'Suíte Infantil Palhinha — Vista completa com poltrona de amamentação em bouclé, tapetes sobrepostos em fibra natural e painel em palhinha',
        badge: '04 · Painel & Amamentação',
      },
    ],
  },
  {
    id: '05',
    category: 'intimos',
    title: 'Suíte Jardim & Pátio',
    meta: 'Interiores · Dormitório & Jardim Íntimo',
    description:
      'A suíte se estende diretamente para um pátio íntimo a céu aberto, transformando a pausa em parte da arquitetura. No interior, o painel envolvente em madeira nogueira, o teto em cimento queimado e a cama baixa de linhas puras constroem uma atmosfera silenciosa que dialoga com a vegetação tropical, as pisadas de concreto e a rede sob paredes em verde-sálvia.',
    ctaLabel: 'Consultar Projeto de Interiores',
    ctaHref: '#contato',
    images: [
      {
        src: `${base}/assets/interiores-suite-jardim-transicao.webp`,
        alt: 'Suíte Jardim & Pátio — Abertura entre o painel em madeira nogueira do dormitório e o pátio externo com rede e vegetação tropical',
        badge: '05 · Transição & Jardim',
      },
      {
        src: `${base}/assets/interiores-suite-jardim-dormitorio.webp`,
        alt: 'Suíte Jardim & Pátio — Dormitório com cama baixa em linho neutro, painel em madeira nogueira, cimento queimado e estante lateral',
        badge: '05 · Dormitório & Marcenaria',
      },
    ],
  },
  {
    id: '06',
    category: 'convivio',
    title: 'Lounge Cromático Bordô',
    meta: 'Interiores · Sala de Estar & Convívio',
    description:
      'Marcado pela imersão cromática em tom bordô que envolve paredes, painel ripado e forro, este estar explora o contraste entre intensidade e leveza. O piso em granilite claro, o sofá curvo em bouclé off-white e o tapete geométrico em degradê ancoram a composição, suavizada pela luz natural filtrada por cortinas verticais e pelos grandes vasos em terracota.',
    ctaLabel: 'Consultar Projeto de Interiores',
    ctaHref: '#contato',
    images: [
      {
        src: `${base}/assets/interiores-lounge-bordo-composicao.webp`,
        alt: 'Lounge Cromático Bordô — Sala de estar com paredes e forro em tom bordô, painel ripado, piso em granilite e sofá curvo off-white',
        badge: '06 · Estar & Arte',
      },
      {
        src: `${base}/assets/interiores-lounge-bordo-estar.webp`,
        alt: 'Lounge Cromático Bordô — Detalhe do sofá curvo em bouclé, mesa de centro orgânica e vasos em terracota junto às cortinas filtrantes',
        badge: '06 · Curvas & Vegetação',
      },
    ],
  },
  {
    id: '07',
    category: 'intimos',
    title: 'Home Office Botânico',
    meta: 'Interiores · Estúdio & Espaço de Trabalho',
    description:
      'Concebido para unir concentração e bem-estar, o espaço de trabalho articula marcenaria ripada em madeira clara, bancada linear contínua e ampla abertura para a luz natural do jardim. O tapete circular em nuances orgânicas de verde e a poltrona escultural em madeira curvada aquecem a base mineral, compondo um ambiente sereno e funcional para a rotina criativa.',
    ctaLabel: 'Consultar Projeto de Interiores',
    ctaHref: '#contato',
    images: [
      {
        src: `${base}/assets/interiores-home-office-bancada.webp`,
        alt: 'Home Office Botânico — Bancada contínua em madeira, painel ripado, poltrona em madeira curvada e tapete circular em tons de verde',
        badge: '07 · Bancada & Marcenaria',
      },
      {
        src: `${base}/assets/interiores-home-office-conjunto.webp`,
        alt: 'Home Office Botânico — Perspectiva ampla do estúdio de trabalho integrado ao jardim externo através de esquadria piso-teto',
        badge: '07 · Estúdio & Paisagem',
      },
    ],
  },
];
---

<!-- ==========================================================================
     SEÇÃO 02 — PROJETOS DE INTERIORES (VALORIZAÇÃO VISUAL ELYSIAN)
     ========================================================================== -->
<section class="section-shell" id="projetos">
  <header class="section-head-editorial">
    <div>
      <div class="section-tag reveal-fade" data-reveal-delay="0.1">
        Arquitetura de Interiores
      </div>
      <h2 class="section-title-large reveal-trigger" data-reveal-delay="0.2">
        Interiores & Atmosferas
      </h2>
    </div>
    <p class="section-subtitle-editorial reveal-para" data-reveal-delay="0.3">
      Uma seleção de projetos de interiores onde materialidade, luz e desenho
      de ambientes se articulam para criar espaços de permanência, equilíbrio e
      identidade.
    </p>
  </header>

  <!-- Filtros de Categorias de Interiores -->
  <div
    class="filter-tabs reveal-fade"
    data-reveal-delay="0.15"
    role="tablist"
    aria-label="Filtrar projetos de interiores"
  >
    <button type="button" class="filter-btn is-active" data-filter="all"
      >Todos os Projetos</button
    >
    <button type="button" class="filter-btn" data-filter="integrados"
      >Ambientes Integrados</button
    >
    <button type="button" class="filter-btn" data-filter="convivio"
      >Estar & Convívio</button
    >
    <button type="button" class="filter-btn" data-filter="intimos"
      >Suítes & Home Office</button
    >
  </div>

  <!-- Grade Editorial Assimétrica Agrupada por Projeto -->
  <div class="projects-editorial-grid" data-reveal-stagger="0.12">
    {
      interiorProjects.map((project) => (
        <article class="project-item" data-category={project.category}>
          <div class="project-media-pair">
            {project.images.map((image) => (
              <div class="project-media-wrap">
                <span class="project-overlay-badge">{image.badge}</span>
                <img
                  src={image.src}
                  alt={image.alt}
                  class="project-media-img"
                  loading="lazy"
                />
              </div>
            ))}
          </div>

          <div class="project-info-row">
            <h3 class="project-title">{project.title}</h3>
            <span class="project-meta-mono">{project.meta}</span>
          </div>
          <p class="project-desc-short">{project.description}</p>
          <a href={project.ctaHref} class="project-link-action">
            {project.ctaLabel}{' '}
            <iconify-icon icon="solar:arrow-right-linear"></iconify-icon>
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  .filter-tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-dark);
    color: var(--text-muted-dark);
    transition: all var(--transition-fast);
  }

  .filter-btn:hover,
  .filter-btn.is-active {
    color: var(--text-primary-dark);
    border-color: var(--accent-bronze);
    background: var(--surface-dark-2);
  }

  .projects-editorial-grid {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  .project-item {
    position: relative;
    display: flex;
    flex-direction: column;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .project-media-pair {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 56px 48px;
    margin-bottom: 24px;
  }

  @media (min-width: 900px) {
    .project-media-pair .project-media-wrap:nth-child(even) {
      margin-top: 80px;
    }
  }

  .project-media-wrap {
    position: relative;
    aspect-ratio: 4 / 4.8;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-dark-2);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  .project-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .project-media-wrap:hover .project-media-img {
    transform: scale(1.045);
  }

  .project-overlay-badge {
    position: absolute;
    top: 18px;
    left: 18px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: rgba(18, 16, 14, 0.75);
    backdrop-filter: blur(10px);
    color: var(--text-primary-dark);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-dark);
  }

  .project-info-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-bottom: 8px;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text-primary-dark);
    transition: color var(--transition-fast);
  }

  .project-item:hover .project-title {
    color: var(--accent-bronze);
  }

  .project-meta-mono {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-subtle-dark);
    letter-spacing: 0.05em;
  }

  .project-desc-short {
    font-size: 0.875rem;
    color: var(--text-muted-dark);
    line-height: 1.6;
    margin-bottom: 16px;
    max-width: 680px;
  }

  .project-link-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-bronze);
    transition: transform var(--transition-fast);
    align-self: flex-start;
  }

  .project-item:hover .project-link-action {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .projects-editorial-grid {
      gap: 56px;
    }

    .project-media-pair {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .project-media-pair .project-media-wrap:nth-child(even) {
      margin-top: 0;
    }
  }
</style>
